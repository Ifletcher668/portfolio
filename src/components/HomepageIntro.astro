---
import { tinaField } from "@tinacms/astro/tina-field";
import type { Homepage } from "../lib/homepage";
interface Props { data: Homepage; }
const { data } = Astro.props;
const buttonColor = data.buttonColor === "paper" ? "var(--color-heading)" : "var(--color-link)";
---
<div class="intro" style={`--color-homepage-button-background:${buttonColor}`}>
      <p class="eyebrow">Software engineer / Drummer / Writer</p>
      <h1 data-tina-field={tinaField(data, "headline")}>{data.headline}</h1>
      <p class="lead">I build software, play drums, and write.</p>
      <p>
        I like making things, understanding how they work, and following ideas
        that interest me. This is a home for the projects, music, writing, and
        occasional curiosities that come out of that.
      </p>
      <div class="actions">
        <a class="button" href="#explore" data-tina-field={tinaField(data, "buttonColor")}>Explore the site ↘</a><a
          href="/about">More about me</a
        >
      </div>
    </div>
<style>
  .eyebrow {
    font: var(--font-weight-label) var(--font-size-label) /
      var(--line-height-label) var(--font-family-body);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    color: var(--color-link);
    margin: 0 0 var(--gap-title-body);
  }
  .intro {
    max-width: 590px;
  }
  .intro > p:not(.eyebrow) {
    max-width: 51ch;
    color: var(--color-text);
  }
  h1 {
    font-size: var(--font-size-title);
    margin: 0 0 var(--gap-title-body);
  }
  .lead {
    font: var(--font-weight-regular) var(--font-size-lede) /
      var(--line-height-lede) var(--font-family-lede) !important;
    color: var(--color-heading) !important;
  }
  .actions {
    display: flex;
    gap: var(--gap-grid);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--gap-action);
  }
  .button {
    background: var(--color-homepage-button-background);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-5);
    text-decoration: none;
    font-weight: var(--font-weight-button);
    border-radius: var(--radius-md);
  }
  .button:hover {
    background: var(--color-heading);
    color: var(--color-bg);
  }
  a:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
