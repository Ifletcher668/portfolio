---
import PageSection from "../PageSection.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import type { SectionData } from "./types";
import type { FeedItem } from "../../lib/feeds";
interface Props {
  data: SectionData;
  feeds?: Record<string, FeedItem[]>;
  onLight?: boolean;
}
const { data, feeds = {}, onLight = false } = Astro.props;
const columns = ["1", "2", "3"].includes(data.columns || "")
  ? data.columns
  : "2";
---

<div
  class:list={[
    "section-columns",
    `columns-${columns}`,
    `column-gap-${["small", "medium", "large"].includes(data.gap || "") ? data.gap : "medium"}`,
    {
      "columns-centered": data.verticalAlignment === "center",
      "columns-bottom": data.verticalAlignment === "end",
    },
  ]}
  data-tina-field={tinaField(data, "items")}
>
  {
    data.items?.map(
      (item) =>
        item && (
          <div
            class="section-column"
            data-tina-field={tinaField(item, "sections")}
          >
            {item.sections?.map(
              (section) =>
                section && (
                  <PageSection
                    data={section}
                    feeds={feeds}
                    onLight={onLight}
                    contained
                  />
                ),
            )}
          </div>
        ),
    )
  }
</div>
