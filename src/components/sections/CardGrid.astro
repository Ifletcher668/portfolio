---
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro";
import { tinaField } from "@tinacms/astro/tina-field";
import { sanitizeHref, sanitizeImageSrc } from "@tinacms/astro/sanitize";
import type { SectionData } from "./types";
interface Props {
  data: SectionData;
}
const { data } = Astro.props;
const columns = ["1", "2", "3"].includes(data.columns || "")
  ? data.columns
  : "2";
---

<div
  class={`section-cards columns-${columns}`}
  data-tina-field={tinaField(data, "cards")}
>
  {
    data.cards
      ?.filter((card) => card !== null)
      .map((card) => (
        <article class="section-card">
          {card.eyebrow && (
            <p
              class="section-eyebrow"
              data-tina-field={tinaField(card, "eyebrow")}
            >
              {card.eyebrow}
            </p>
          )}
          {card.heading && (
            <h3 data-tina-field={tinaField(card, "heading")}>{card.heading}</h3>
          )}
          {sanitizeImageSrc(card.image) && (
            <img
              class="section-image ratio-landscape"
              src={sanitizeImageSrc(card.image)}
              alt={card.imageAlt || ""}
              loading="lazy"
              data-tina-field={tinaField(card, "image")}
            />
          )}
          <div class="section-prose" data-tina-field={tinaField(card, "body")}>
            <TinaMarkdown content={card.body} />
          </div>
          {card.linkLabel && card.linkUrl && (
            <a
              class="section-card-action"
              href={sanitizeHref(card.linkUrl)}
              data-tina-field={tinaField(card, "linkUrl")}
            >
              {card.linkLabel}
            </a>
          )}
        </article>
      ))
  }
</div>
