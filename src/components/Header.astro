---
import { SITE_TITLE } from "../consts";
const links = [
  { href: "/code", label: "Code" },
  { href: "/music", label: "Music" },
  { href: "/writing", label: "Writing" },
  { href: "/about", label: "About" },
];
---
<header class="site-header">
  <nav aria-label="Primary navigation">
    <a class="brand" href="/">{SITE_TITLE}</a>
    <div class="nav-links">{links.map(({href,label}) => <a href={href}>{label}</a>)}</div>
  </nav>
</header>
<style>
  .site-header{position:relative;z-index:10;background:#252f2c;border-bottom:1px solid #48584d;color:#e2d7bb}
  nav{max-width:1200px;margin:auto;padding:1.15rem clamp(1.2rem,5vw,4rem);display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap}
  .brand{font-family:Georgia,serif;font-size:1.4rem;letter-spacing:.01em}
  .nav-links{display:flex;gap:clamp(.8rem,3vw,2rem);flex-wrap:wrap}
  a{color:#e2d7bb;text-decoration:none;font-size:1rem}
  a:hover{color:#a9c1a3}
  a:focus-visible{outline:3px solid #bf8f68;outline-offset:4px}
  @media(max-width:540px){nav{gap:.65rem}.nav-links{width:100%;justify-content:space-between}}
</style>