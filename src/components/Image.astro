---
import { EXTERNAL_LINKS } from "../consts.ts";
interface Props {
  width: number;
  height: number;
  src: string;
  credit?: string;
  alt?: string;
  className?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  width = 1020,
  height = 510,
  src,
  alt = "",
  credit,
  className,
} = Astro.props;
---

<div class={`${className} image-container`}>
  <img width={width} height={height} src={src} alt={alt} />
  <small
    >{
      credit ? (
        credit
      ) : (
        <>
          Photo taken by
          <a
            href={EXTERNAL_LINKS.shelbzWebsite}
            target="_blank"
            rel="noopener noreferrer"
          >
            Shelbz Citrine
          </a>
        </>
      )
    }
  </small>
</div>

<style>
  .image-container {
    position: relative;
    display: inline-block;
  }
  .image-container > img {
    display: block;
  }

  .image-container > small {
    transition: all 0.25s;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--color-caption-overlay);
    color: var(--color-caption-text);
    text-align: center;
    padding: var(--space-2);
    font-size: var(--font-size-caption);
    font-style: italic;
    opacity: 0;
  }
  .image-container:hover > small {
    opacity: 1;
  }

  @media (max-width: 720px) {
    .image-container > small {
      opacity: 1;
      background: none;
      padding: 0;
      position: unset;
    }
  }
</style>
