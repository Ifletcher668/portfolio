---
import ImageAnnotation from "./ImageAnnotation.astro";
interface Props {
  width: number;
  height: number;
  src: string;
  credit?: string;
  alt?: string;
  className?: string;
}

const {
  width = 1020,
  height = 510,
  src,
  alt = "",
  credit,
  className,
} = Astro.props;
---

<ImageAnnotation
  class={className}
  credit={credit || "Photo taken by Shelbz Citrine (shelbzcitrine.com)"}
>
  <img width={width} height={height} src={src} alt={alt} />
</ImageAnnotation>
