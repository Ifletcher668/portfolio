<div class="spiral-mist-background" aria-hidden="true" data-spiral-mist-background>
  <canvas data-mist-canvas></canvas>
</div>
<style>
  .spiral-mist-background { position:absolute; inset:-12% -10%; overflow:hidden; pointer-events:none; z-index:0; opacity:.75; mask-image:radial-gradient(ellipse at 42% 50%,#000 8%,transparent 74%); }
  canvas { display:block; width:100%; height:100%; }
  @media(max-width:800px){.spiral-mist-background{inset:-5%;opacity:.5}}
  @media(prefers-reduced-motion:reduce){.spiral-mist-background{display:none}}
</style>
<script>
  import * as THREE from "three";
  const host = document.querySelector<HTMLElement>("[data-spiral-mist-background]");
  const canvas = host?.querySelector<HTMLCanvasElement>("[data-mist-canvas]");
  if (host && canvas && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, .1, 100);
    camera.position.z = 9;
    const renderer = new THREE.WebGLRenderer({canvas,alpha:true,antialias:false,powerPreference:"low-power"});
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
    const count = 2600;
    const positions = new Float32Array(count*3);
    const colors = new Float32Array(count*3);
    const sizes = new Float32Array(count);
    // Deterministic distribution: broad, loosely wound strands with feathered edges.
    const random = (n:number) => { const x = Math.sin(n*127.1+78.233)*43758.5453; return x-Math.floor(x); };
    const sage = new THREE.Color(0xa9c1a3);
    const copper = new THREE.Color(0xbf8f68);
    const moss = new THREE.Color(0x657f70);
    for(let i=0;i<count;i++){
      const arm = i%4;
      const r = Math.sqrt(random(i+2))*3.25;
      const angle = r*1.4+arm*Math.PI/2+(random(i+19)-.5)*1.25;
      const spread = .18+.30*r;
      const x = Math.cos(angle)*r+(random(i+41)-.5)*spread;
      const y = Math.sin(angle)*r*.62+(random(i+53)-.5)*spread;
      positions[i*3]=x;
      positions[i*3+1]=y;
      positions[i*3+2]=(random(i+71)-.5)*1.35;
      const tone = random(i+89);
      const color = tone>.91 ? copper : tone>.35 ? sage : moss;
      colors[i*3]=color.r;colors[i*3+1]=color.g;colors[i*3+2]=color.b;
      sizes[i]=3+random(i+97)*10;
    }
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position",new THREE.BufferAttribute(positions,3));
    geometry.setAttribute("color",new THREE.BufferAttribute(colors,3));
    geometry.setAttribute("aSize",new THREE.BufferAttribute(sizes,1));
    const material = new THREE.ShaderMaterial({
      transparent:true,depthWrite:false,blending:THREE.NormalBlending,
      uniforms:{uPixelRatio:{value:renderer.getPixelRatio()}},
      vertexShader:`
        attribute float aSize;
        varying vec3 vColor;
        uniform float uPixelRatio;
        void main(){
          vColor=color;
          vec4 viewPosition=modelViewMatrix*vec4(position,1.);
          gl_Position=projectionMatrix*viewPosition;
          gl_PointSize=min(50.,aSize*uPixelRatio*(8./max(2.,-viewPosition.z)));
        }
      `,
      fragmentShader:`
        varying vec3 vColor;
        void main(){
          float radius=length(gl_PointCoord-.5)*2.;
          float haze=exp(-radius*radius*5.);
          float edge=smoothstep(1.,.5,radius);
          gl_FragColor=vec4(vColor,haze*edge*.105);
        }
      `,
      vertexColors:true
    });
    const cloud = new THREE.Points(geometry,material);
    cloud.rotation.z=-.28;
    cloud.position.x=-.6;
    scene.add(cloud);
    let frame=0,visible=true;
    let targetX=0,targetY=0,pointerX=0,pointerY=0;
    const resize=()=>{
      const w=host.clientWidth,h=host.clientHeight;
      if(!w||!h)return;
      camera.aspect=w/h;
      camera.updateProjectionMatrix();
      renderer.setSize(w,h,false);
      material.uniforms.uPixelRatio.value=renderer.getPixelRatio();
    };
    const resizeObserver=new ResizeObserver(resize);
    resizeObserver.observe(host);
    resize();
    const onPointer=(event:PointerEvent)=>{
      targetX=(event.clientX/window.innerWidth-.5)*.18;
      targetY=(event.clientY/window.innerHeight-.5)*.14;
    };
    window.addEventListener("pointermove",onPointer,{passive:true});
    const draw=()=>{
      frame=0;
      if(!visible||document.hidden)return;
      pointerX+=(targetX-pointerX)*.018;
      pointerY+=(targetY-pointerY)*.018;
      cloud.rotation.z+=.00028;
      cloud.rotation.y=pointerX;
      cloud.rotation.x=pointerY;
      renderer.render(scene,camera);
      frame=requestAnimationFrame(draw);
    };
    const intersectionObserver=new IntersectionObserver(entries=>{
      visible=entries[0]?.isIntersecting??false;
      if(visible&&!frame)frame=requestAnimationFrame(draw);
    });
    intersectionObserver.observe(host);
    const onVisibility=()=>{if(!document.hidden&&visible&&!frame)frame=requestAnimationFrame(draw);};
    document.addEventListener("visibilitychange",onVisibility);
    draw();
    document.addEventListener("astro:before-swap",()=>{
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      window.removeEventListener("pointermove",onPointer);
      document.removeEventListener("visibilitychange",onVisibility);
      geometry.dispose();
      material.dispose();
      renderer.dispose();
    },{once:true});
  }
</script>