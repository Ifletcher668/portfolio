---
import Home from "./Home.astro";
interface Props { title?: string; description?: string; heroImage?: string; compactIntro?: boolean; }
const { title = "Archive", description = "From the personal archive of Isiah Fletcher.", heroImage, compactIntro = false } = Astro.props;
---
<Home title={title === "Archive" ? "Archive — Isiah Fletcher" : `${title} — Isiah Fletcher`} description={description}>
  <article class:list={["archive-page", { "compact-intro": compactIntro }]}>
    <header class="archive-header">
      <p class="archive-eyebrow"><a href="/">Home</a> / Archive</p>
      <h1>{title}</h1>
    </header>
    {heroImage && <img class="archive-hero" src={heroImage} alt="" loading="lazy" />}
    <div class="archive-content"><slot /></div>
  </article>
</Home>
<style is:global>
  .archive-page {
    --accent: var(--color-link);
    --accent-dark: var(--color-accent);
    --accent-light: var(--color-text);
    --accent-lightest: var(--color-surface);
    --accent-bright: 169,193,163;
    --black: 37,47,44;
    --white: 226,215,187;
    --gray: 83,98,89;
    --gray-dark: 52,68,60;
    width: min(var(--layout-content), calc(100% - 2 * var(--page-gutter)));
    margin: 0 auto;
    padding: var(--page-padding-start) 0 var(--page-padding-end);
    color: var(--color-text);
  }
  .archive-page .archive-header { margin-bottom: var(--gap-section); }
  .archive-page.compact-intro .archive-header { margin-bottom:var(--gap-intro); }
  .archive-page.compact-intro .archive-content > .resume-intro { margin-bottom:var(--gap-intro); }
  .archive-page .archive-eyebrow { font: var(--font-weight-label) var(--font-size-label)/var(--line-height-label) var(--font-family-body); letter-spacing: var(--letter-spacing-label); text-transform: uppercase; color: var(--color-link); margin: 0 0 var(--gap-label); }
  .archive-page .archive-eyebrow a { color: inherit; }
  .archive-page h1 { font: var(--font-weight-regular) var(--font-size-title)/var(--line-height-display) var(--font-family-display); color: var(--color-heading); margin: 0; }
  .archive-page h2, .archive-page h3, .archive-page h4, .archive-page h5 { font-family: var(--font-family-display); font-weight: var(--font-weight-regular); color: var(--color-heading); }
  .archive-page h2 { font-size: var(--font-size-section); }
  .archive-page h3 { font-size: var(--font-size-card); }
  .archive-page p, .archive-page li { color: var(--color-text); }
  .archive-page a { color: var(--color-link); }
  .archive-page a:hover { color: var(--color-heading); }
  .archive-page .archive-hero { display:block; width:100%; max-height:520px; object-fit:cover; margin:0 0 2.5rem; border-radius:4px; }
  .archive-page .archive-content { min-width:0; }
  .archive-page .archive-content > p { max-width:78ch; }
  .archive-page .archive-content > iframe { max-width:100%; }
  .archive-page .archive-content > :not(:last-child) { margin-bottom:var(--gap-prose); }
  .archive-page .archive-content > section:not(:last-child) { margin-bottom:var(--gap-section); }
  .archive-page .resume-highlights h2, .archive-page .resume-section h2 { font-size:var(--font-size-subsection); margin:0 0 var(--gap-section-heading); }
  .archive-page .resume-section h3 { font-size:var(--font-size-job); line-height:var(--line-height-heading); margin:0 0 var(--gap-label); }
  .archive-page .resume-section > ul { margin-bottom:var(--gap-job); }
  .archive-page .highlight-item, .archive-page .card, .archive-page .poem { background:var(--color-surface); color:var(--color-heading); }
  .archive-page .highlight-item strong { color:var(--color-heading); }
  .archive-page .blog-container { padding:0; }
  .archive-page .blog-intro-and-subscribe iframe { max-width:100%; }
  @media(max-width:700px){.archive-page{padding-bottom:var(--page-padding-end)}.archive-page .archive-hero{max-height:320px}}
</style>