---
import MediaPreviewImages from "../components/MediaPreviewImages.astro";
import SiteTheme from "../components/SiteTheme.astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PointerInteractions from "../components/PointerInteractions.astro";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Isiah Fletcher — Code, Music & Writing",
  description = "The personal home of Isiah Fletcher: software engineer, drummer, and writer.",
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        background: var(--color-bg);
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--color-bg);
        color: var(--color-text);
        font: var(--font-size-body) / var(--line-height-body)
          var(--font-family-body);
      }
      h1,
      h2,
      h3 {
        font-family: var(--font-family-display);
        font-weight: var(--font-weight-regular);
        color: var(--color-heading);
        line-height: var(--line-height-display);
      }
      a {
        color: var(--color-link);
      }
      a:hover {
        color: var(--color-heading);
      }
      a:focus-visible {
        outline: 3px solid var(--color-accent);
        outline-offset: 4px;
      }
      ::selection {
        background: var(--color-link);
        color: var(--color-bg);
      }
      /* Shared tactile states for both the archive and current pages. */
      a,
      button {
        -webkit-tap-highlight-color: transparent;
      }
      a {
        text-underline-offset: 0.22em;
        transition:
          color 0.2s ease,
          text-decoration-color 0.2s ease;
      }
      a:active {
        color: var(--color-accent);
      }
      button,
      .button,
      [role="button"] {
        transition:
          background-color 0.22s ease,
          color 0.22s ease,
          transform 0.22s ease,
          box-shadow 0.22s ease;
      }
      button:active,
      .button:active,
      [role="button"]:active {
        transform: translateY(2px) scale(0.985);
      }
      .feature,
      .interior .panel,
      .archive-page .card,
      .archive-page .poem,
      .archive-page .highlight-item {
        transition:
          transform 0.35s cubic-bezier(0.2, 0.75, 0.25, 1),
          box-shadow 0.35s ease,
          border-color 0.35s ease;
      }
      @media (hover: hover) and (pointer: fine) {
        .feature:hover,
        .interior .panel:hover,
        .archive-page .card:hover,
        .archive-page .poem:hover,
        .archive-page .highlight-item:hover {
          transform: translateY(-5px);
          box-shadow: var(--shadow-card-hover);
        }
        .button:hover {
          transform: translateY(-2px);
          box-shadow: var(--shadow-button-hover);
        }
      }
      /* Underlines draw in without changing the line box or shifting text. */
      main a:not(.button),
      .site-header .nav-links a,
      .site-header .brand {
        text-decoration: none;
        background-image: linear-gradient(currentColor, currentColor);
        background-position: 0 100%;
        background-repeat: no-repeat;
        background-size: 0 1px;
        transition:
          background-size 0.26s ease,
          color 0.2s ease;
      }
      main a:not(.button):hover,
      main a:not(.button):focus-visible,
      .site-header .nav-links a:hover,
      .site-header .nav-links a:focus-visible,
      .site-header .brand:hover,
      .site-header .brand:focus-visible {
        background-size: 100% 1px;
      }
      a.button,
      button,
      [role="button"] {
        position: relative;
        overflow: hidden;
        isolation: isolate;
      }
      .interaction-ripple {
        position: absolute;
        pointer-events: none;
        border-radius: 50%;
        background: var(--color-ripple);
        transform: scale(0);
        animation: interaction-ripple 0.5s ease-out forwards;
        z-index: 0;
      }
      .button .interaction-ripple {
        background: var(--color-ripple-on-light);
      }
      @keyframes interaction-ripple {
        to {
          transform: scale(1);
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .interaction-ripple {
          display: none;
        }
        main a:not(.button),
        .site-header .nav-links a,
        .site-header .brand {
          transition: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* The shared stylesheet constrains main to 720px for articles. The homepage needs a full-width canvas. */
      main#main-content {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>
  <body>
    <SiteTheme />
    <a class="skip" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <PointerInteractions />
    <MediaPreviewImages />
    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: var(--space-4);
        background: var(--color-heading);
        color: var(--color-bg);
        padding: var(--space-2);
        z-index: 100;
      }
      .skip:focus {
        left: var(--space-4);
      }
    </style>
  </body>
</html>
