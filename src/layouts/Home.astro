---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PointerInteractions from "../components/PointerInteractions.astro";
interface Props { title?: string; description?: string; }
const { title = "Isiah Fletcher — Code, Music & Writing", description = "The personal home of Isiah Fletcher: software engineer, drummer, and writer." } = Astro.props;
---
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style is:global>
      :root { --forest:#252f2c; --moss:#34443c; --sage:#a9c1a3; --paper:#e2d7bb; --copper:#bf8f68; }
      *,*::before,*::after { box-sizing:border-box; }
      html { background:var(--forest); scroll-behavior:smooth; }
      body { margin:0; background:var(--forest); color:var(--paper); font: 17px/1.65 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
      h1,h2,h3 { font-family:"CormorantGaramond",Georgia,serif; font-weight:400; color:var(--paper); line-height:1.08; }
      a { color:var(--sage); }
      a:hover { color:var(--paper); }
      a:focus-visible { outline:3px solid var(--copper); outline-offset:4px; }
      ::selection { background:var(--sage); color:var(--forest); }
      /* Shared tactile states for both the archive and current pages. */
      a,button { -webkit-tap-highlight-color:transparent; }
      a { text-underline-offset:.22em; transition:color .2s ease,text-decoration-color .2s ease; }
      a:active { color:var(--copper); }
      button,.button,[role="button"] { transition:background-color .22s ease,color .22s ease,transform .22s ease,box-shadow .22s ease; }
      button:active,.button:active,[role="button"]:active { transform:translateY(2px) scale(.985); }
      .feature,.interior .panel,.archive-page .card,.archive-page .poem,.archive-page .highlight-item {
        transition:transform .35s cubic-bezier(.2,.75,.25,1),box-shadow .35s ease,border-color .35s ease;
      }
      @media(hover:hover) and (pointer:fine) {
        .feature:hover,.interior .panel:hover,.archive-page .card:hover,.archive-page .poem:hover,.archive-page .highlight-item:hover {
          transform:translateY(-5px);
          box-shadow:0 18px 40px rgba(10,20,16,.22);
        }
        .button:hover { transform:translateY(-2px); box-shadow:0 9px 24px rgba(10,20,16,.22); }
      }
      /* Underlines draw in without changing the line box or shifting text. */
      main a:not(.button),.site-header .nav-links a,.site-header .brand {
        text-decoration:none;
        background-image:linear-gradient(currentColor,currentColor);
        background-position:0 100%;
        background-repeat:no-repeat;
        background-size:0 1px;
        transition:background-size .26s ease,color .2s ease;
      }
      main a:not(.button):hover,main a:not(.button):focus-visible,
      .site-header .nav-links a:hover,.site-header .nav-links a:focus-visible,
      .site-header .brand:hover,.site-header .brand:focus-visible {background-size:100% 1px;}
      a.button,button,[role="button"] {position:relative;overflow:hidden;isolation:isolate;}
      .interaction-ripple {position:absolute;pointer-events:none;border-radius:50%;background:rgba(226,215,187,.28);transform:scale(0);animation:interaction-ripple .5s ease-out forwards;z-index:0;}
      .button .interaction-ripple {background:rgba(37,47,44,.18);}
      @keyframes interaction-ripple {to {transform:scale(1);opacity:0;}}
      @media(prefers-reduced-motion:reduce) {
        .interaction-ripple{display:none;}
        main a:not(.button),.site-header .nav-links a,.site-header .brand {transition:none;}
      }
      @media(prefers-reduced-motion:reduce) {
        *,*::before,*::after { animation-duration:.01ms!important; animation-iteration-count:1!important; transition-duration:.01ms!important; scroll-behavior:auto!important; }
      }

      /* The shared stylesheet constrains main to 720px for articles. The homepage needs a full-width canvas. */
      main#main-content { width:100%; max-width:none; margin:0; padding:0; }
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    </style>
  </head>
  <body>
    <a class="skip" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <PointerInteractions />
    <style>.skip{position:absolute;left:-9999px;top:1rem;background:#e2d7bb;color:#252f2c;padding:.6rem;z-index:100}.skip:focus{left:1rem}</style>
  </body>
</html>