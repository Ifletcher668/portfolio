---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props { title?: string; description?: string; }
const { title = "Isiah Fletcher — Code, Music & Writing", description = "The personal home of Isiah Fletcher: software engineer, drummer, and writer." } = Astro.props;
---
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style is:global>
      :root { --forest:#252f2c; --moss:#34443c; --sage:#a9c1a3; --paper:#e2d7bb; --copper:#bf8f68; }
      *,*::before,*::after { box-sizing:border-box; }
      html { background:var(--forest); scroll-behavior:smooth; }
      body { margin:0; background:var(--forest); color:var(--paper); font: 17px/1.65 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
      h1,h2,h3 { font-family:"CormorantGaramond",Georgia,serif; font-weight:400; color:var(--paper); line-height:1.08; }
      a { color:var(--sage); }
      a:hover { color:var(--paper); }
      a:focus-visible { outline:3px solid var(--copper); outline-offset:4px; }
      ::selection { background:var(--sage); color:var(--forest); }
      /* The shared stylesheet constrains main to 720px for articles. The homepage needs a full-width canvas. */
      main#main-content { width:100%; max-width:none; margin:0; padding:0; }
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    </style>
  </head>
  <body>
    <a class="skip" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <style>.skip{position:absolute;left:-9999px;top:1rem;background:#e2d7bb;color:#252f2c;padding:.6rem;z-index:100}.skip:focus{left:1rem}</style>
  </body>
</html>