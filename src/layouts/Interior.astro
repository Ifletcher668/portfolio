---
import Home from "./Home.astro";
interface Props { title: string; description: string; eyebrow: string; heading: string; intro: string; }
const { title, description, eyebrow, heading, intro } = Astro.props;
---
<Home title={title} description={description}>
  <div class="interior shell">
    <header class="page-intro">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="lede">{intro}</p>
    </header>
    <slot />
  </div>
</Home>
<style is:global>
  .interior.shell{width:min(var(--layout-content),calc(100% - 2 * var(--page-gutter)));margin-inline:auto;padding:var(--page-padding-start) 0 var(--page-padding-end)}
  .interior .page-intro{max-width:var(--layout-prose);margin-bottom:var(--gap-section)}
  .interior .eyebrow{font:var(--font-weight-label) var(--font-size-label)/var(--line-height-label) var(--font-family-body);letter-spacing:var(--letter-spacing-label);text-transform:uppercase;color:var(--color-link);margin:0 0 var(--gap-label)}
  .interior h1{font-size:var(--font-size-title);margin:0 0 var(--space-5)}
  .interior h2{font-size:var(--font-size-section);margin:0 0 var(--gap-section-heading)}
  .interior h3{font-size:var(--font-size-card);line-height:var(--line-height-heading);margin:0 0 var(--gap-title-body)}
  .interior p{color:var(--color-text);margin:0 0 var(--gap-prose)}
  .interior .lede{font:var(--font-weight-regular) var(--font-size-lede)/var(--line-height-lede) var(--font-family-lede);color:var(--color-heading);max-width:42ch}
  .interior .section{border-top:1px solid var(--color-border);padding-block:var(--gap-section)}
  .interior .grid-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--gap-grid)}
  .interior .panel{background:var(--color-surface);padding:var(--card-padding)}
  .interior .panel > :last-child{margin-bottom:0}
  .interior .media{width:100%;aspect-ratio:16/9;object-fit:cover;margin-bottom:var(--gap-prose)}
  .interior .video{width:100%;aspect-ratio:16/9;margin-bottom:var(--gap-prose)}
  .interior .video iframe{width:100%;height:100%;border:0}
  .interior a{color:var(--color-link)}
  .interior a:hover{color:var(--color-link-hover)}
  .interior .small{font-size:var(--font-size-caption);color:var(--color-muted)}
  /* Explicit card relationships prevent paragraph margins from flattening hierarchy. */
  .interior .essay-card{display:flex;flex-direction:column;align-items:flex-start}
  .interior .essay-card .essay-date{margin:0 0 var(--space-5)}
  .interior .essay-card h3{margin:0 0 var(--gap-title-body)}
  .interior .essay-card .essay-summary{margin:0 0 var(--gap-action)}
  .interior .essay-card .essay-action{margin-top:auto}
  @media(max-width:700px){.interior .grid-two{grid-template-columns:1fr}}
</style>
