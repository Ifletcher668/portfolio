---
import Layout from "../layouts/Page.astro";
import { SOCIAL_LINKS } from "../consts";
---

<Layout
  title="Connect with me on Social Media"
  description="Find Isiah Fletcher on Substack, Facebook, Instagram, YouTube, and more. Connect for drumming sessions, software development inquiries, and creative collaborations."
>
  <div class="links">
    <a href="/"> My Portfolio</a>

    <a href={SOCIAL_LINKS.substack} target="__blank"> Substack</a>

    <a href={SOCIAL_LINKS.facebook} target="_blank"> Facebook</a>

    <a href={SOCIAL_LINKS.instagram} target="_blank"> Instagram</a>

    <a href={SOCIAL_LINKS.youtube} target="__blank"> Youtube</a>
  </div>
</Layout>

<style>
  .links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .links a {
    display: block;
    width: 300px;
    max-width: 90%;
    margin: 1rem auto;
    padding: 1rem 1.5rem;
    text-align: center;
    font-size: 1.125rem;
    font-weight: bold;
    color: #e2d7bb;
    background: #34443c;
    border: 1px solid #536259;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .links a:hover {
    color: #a9c1a3;
    background: #415449;
    box-shadow: none;
    transform: translateY(-2px);
  }

  .links a:active {
    transform: scale(0.97);
    box-shadow: none;
  }
</style>
