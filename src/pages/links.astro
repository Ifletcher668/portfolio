---
import Layout from "../layouts/Page.astro";
import { SOCIAL_LINKS } from "../consts";
---

<Layout
  title="Connect with me on Social Media"
  description="Find Isiah Fletcher on Substack, Facebook, Instagram, YouTube, and more. Connect for drumming sessions, software development inquiries, and creative collaborations."
>
  <div class="links">
    <a href="/"> My Portfolio</a>

    <a href={SOCIAL_LINKS.substack} target="__blank"> Substack</a>

    <a href={SOCIAL_LINKS.facebook} target="_blank"> Facebook</a>

    <a href={SOCIAL_LINKS.instagram} target="_blank"> Instagram</a>

    <a href={SOCIAL_LINKS.youtube} target="__blank"> Youtube</a>
  </div>
</Layout>

<style>
  .links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .links a {
    display: block;
    width: 300px;
    max-width: 90%;
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    text-align: center;
    font-size: var(--font-size-card-label);
    font-weight: var(--font-weight-strong);
    color: var(--color-heading);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .links a:hover {
    color: var(--color-link);
    background: var(--color-surface-hover);
    box-shadow: none;
    transform: translateY(-2px);
  }

  .links a:active {
    transform: scale(0.97);
    box-shadow: none;
  }
</style>
