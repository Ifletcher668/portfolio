---
import Interior from "../layouts/Interior.astro";
import { getSubstackPosts } from "../lib/substack";
let posts = [];
try { posts = (await getSubstackPosts())?.slice(0,6) ?? []; } catch (error) { console.warn("Substack unavailable", error); }
---
<Interior title="Writing — Isiah Fletcher" description="Essays, reflections, and poetry by Isiah Fletcher." eyebrow="03 / Writing" heading="Notes from a wandering mind." intro="Essays, poetry, and whatever questions I can't quite leave alone.">
  <section class="section grid-two">
    <div><h2>Gimbles and Toads</h2><p>On Substack, I write about philosophy, creativity, memory, and the strange business of being human. Some pieces are personal; others begin with an idea and follow it wherever it leads.</p><p><a href="https://isiahfletcher7.substack.com/" target="_blank" rel="noopener noreferrer">Read and subscribe on Substack ↗</a></p></div>
    <div class="panel"><p class="eyebrow">Closer to home</p><h3>Poetry and other writing</h3><p>Some of my poems live in the site's earlier collection while I work toward a more curated archive.</p><a href="/hobbies">Read selected poems ↗</a></div>
  </section>
  <section class="section"><p class="eyebrow">Recent essays</p><h2>From Substack</h2>
    {posts.length > 0 ? <div class="grid-two">{posts.map((post) => <article class="panel"><p class="small">{post.date?.toLocaleDateString("en-US",{month:"long",year:"numeric"})}</p><h3>{post.title}</h3><p>{post.excerpt}</p><a href={post.link} target="_blank" rel="noopener noreferrer">Read on Substack ↗</a></article>)}</div> : <p>The latest essays are available directly on <a href="https://isiahfletcher7.substack.com/" target="_blank" rel="noopener noreferrer">Substack ↗</a>.</p>}
  </section>
</Interior>