---
import Image from "../../components/Image.astro";
import Layout from "../../layouts/Page.astro";
import { PROJECT_LINKS_ARRAY } from "../../consts";
---

<Layout
  title="Projects"
  description="Explore software projects by Isiah Fletcher, including Rhythm Desk, Three.js experiments, and the Shelbz Citrine portfolio."
>
  <ul class="simple-list">
    {
      PROJECT_LINKS_ARRAY.map((project, index) => {
        const isExternalLink = project.href.startsWith("http");
        return (
          <li class="project-link">
            <h5>
              <a
                target={isExternalLink ? "_blank" : "_self"}
                rel={isExternalLink ? "noopener" : undefined}
                href={project.href}
              >
                <span class="letter">{index + 1}.</span>
                {project.title}
              </a>
            </h5>
            {project.description && <p>{project.description}</p>}
            <Image
              width={project.imageSize?.width ?? 666}
              height={project.imageSize?.height ?? 510}
              src={project.imgSrc}
              alt={project.imgAlt ?? ""}
              credit={project.imageCredit ?? "Photo by Isiah Fletcher"}
            />
          </li>
        );
      })
    }
  </ul>
</Layout>
<style>
  .project-link a {
    text-decoration: none;
  }

  .project-link .letter {
    font-size: var(--font-size-job);
  }
</style>
